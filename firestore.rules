rules_version = '2';

// Collab — Firestore security rules.
// Publish: `firebase deploy --only firestore:rules` (or paste into Firebase console → Firestore → Rules).
// Data layout is documented in src/lib/discover.ts and src/lib/connections.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // ---------- Profiles ----------
    match /users/{uid} {
      // Discover needs to read other people's profiles. Nothing private lives here
      // (login email is in Firebase Auth, not in this document).
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 500)
        && (!('groupName' in request.resource.data) || request.resource.data.groupName.size() <= 50);
      allow delete: if isMe(uid);

      // "I liked them". The liked person may read it: that's how a mutual like is detected.
      match /likes/{otherUid} {
        allow read: if isMe(uid) || isMe(otherUid);
        allow create, delete: if isMe(uid) && otherUid != uid;
      }

      // Who liked me. Written only by the server (functions/index.js onLikeCreated).
      match /likedBy/{otherUid} {
        allow read: if isMe(uid);
      }

      // Private to the owner.
      match /passes/{otherUid} {
        allow read, create, delete: if isMe(uid);
      }
      match /blocks/{otherUid} {
        allow read, create, delete: if isMe(uid);
      }
    }

    // ---------- Connections and chat ----------
    // matches/{uidA_uidB}, members sorted, created only when both likes exist.
    match /matches/{matchId} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }

      // `get` on a not-yet-existing connection is allowed so the app can check before creating it.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if isMember();

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.members[0] < request.resource.data.members[1]
        && matchId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0])/likes/$(request.resource.data.members[1]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1])/likes/$(request.resource.data.members[0]));

      // Members can update chat bookkeeping (last message, read markers) and close/block it,
      // but can't change who's in it.
      allow update: if isMember()
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastRead', 'blockedBy', 'closedBy', 'updatedAt']);

      allow delete: if false;

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/matches/$(matchId)).data; }
        function inChat() { return signedIn() && request.auth.uid in chat().members; }
        function chatOpen() { return !('blockedBy' in chat()) && !('closedBy' in chat()); }

        allow read: if inChat();
        allow create: if inChat()
          && chatOpen()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          // Voice notes carry a Firebase Storage URL and a length (max ~2 min).
          && (!('audioUrl' in request.resource.data)
              || (request.resource.data.audioUrl is string
                  && request.resource.data.audioUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
                  && request.resource.data.durationMs is number
                  && request.resource.data.durationMs <= 130000));
        // Reactions: either member can set or clear their own reaction (reactions.{uid}) and nothing else.
        allow update: if inChat()
          && chatOpen()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('reactions', {}))
              || request.resource.data.reactions[request.auth.uid] in ['❤️', '👍', '🔥', '😂', '😮', '🙏']);
        // You can delete your own messages (used when deleting your account).
        allow delete: if inChat() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- Push notification tokens ----------
    // pushTokens/{uid}: { tokens: [...] }. Private to the owner; Cloud Functions read it to send alerts.
    match /pushTokens/{uid} {
      allow read, write: if isMe(uid);
    }

    // ---------- Usage signals for the tester dashboard ----------
    // activity/{uid}: { days, stepsReached, skipped } — lists of short strings. Owner-only; the server reads it.
    match /activity/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['days', 'stepsReached', 'skipped'])
        && (!('days' in request.resource.data) || request.resource.data.days.size() <= 400)
        && (!('stepsReached' in request.resource.data) || request.resource.data.stepsReached.size() <= 20)
        && (!('skipped' in request.resource.data) || request.resource.data.skipped.size() <= 20);
      allow delete: if isMe(uid);
    }

    // ---------- Reports ----------
    // Write-only from the app; reviewed in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100
        && (!('details' in request.resource.data) || request.resource.data.details.size() <= 1000);
      allow read, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
